# Copy to deploy/.env (git-ignored) and fill in.

# Public hostname pointing at this server (A/AAAA record). Used for HTTPS, passkeys and the verifier URL.
DOMAIN=demo.example.com

# World ID (IDKit 4.x), same values as web/.env.local.
WLD_APP_ID=
WLD_RP_ID=
WLD_ENVIRONMENT=production
WLD_CREDENTIAL=mnc
RP_SIGNING_KEY=

# Shared by web and verifier. Generate with: openssl rand -hex 32
VERIFIER_SHARED_SECRET=
