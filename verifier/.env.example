# Copy to verifier/.env (git-ignored). Loaded automatically by the verifier and native_prover.

# Where the verifier listens (WebSocket endpoints /prove, /relay, /result).
VERIFIER_LISTEN=127.0.0.1:7047
# Web app base URL; proofs are POSTed to $WEB_URL/api/internal/myna-proof.
WEB_URL=http://localhost:3000
# Must equal VERIFIER_SHARED_SECRET in web/.env.local.
VERIFIER_SHARED_SECRET=change-me
# Upper limits the verifier accepts from a prover (bytes).
MAX_SENT_DATA=4096
MAX_RECV_DATA=32768
# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,yamux=warn,tlsn_mux=warn

# --- native_prover only ---
# VERIFIER_URL=ws://localhost:7047
# METHOD=prescription
# GROUP_ID=hayfever
# Full Cookie header copied from a logged-in myna.go.jp session. Never logged.
# Prefer passing it inline on the command line instead of storing it here.
# MYNA_COOKIE=SESSION=...; tid=...
