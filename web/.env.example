# Copy to .env.local and fill in. Never commit .env.local.

# World ID (IDKit 4.x)
WLD_APP_ID=app_974a393b0e993fea57c82f67e67ab8fd
WLD_RP_ID=rp_4e87aa1d9faa8961
# "staging" works with the simulator (https://simulator.worldcoin.org/); use "production" for real World App.
WLD_ENVIRONMENT=staging
# World ID credential required to join: mnc (My Number Card, default), proof_of_human (Orb),
# passport (World ID 4.0 only)
WLD_CREDENTIAL=mnc
# Server-only RP signing key (hex) from the World developer portal. Never expose to the client.
RP_SIGNING_KEY=

# Shared secret the verifier sends as the x-verifier-secret header to /api/internal/myna-proof.
# Must equal the verifier's VERIFIER_SHARED_SECRET. Generate with: openssl rand -hex 32
VERIFIER_SHARED_SECRET=

# Verifier WebSocket URL handed to the extension.
VERIFIER_URL=ws://localhost:7047

# SQLite file (sql.js, persisted to disk). Relative to web/.
DB_PATH=data/mynachat.sqlite

# Dev only: shows a button that marks a pending session myna_verified without the extension.
DEV_FAKE_MYNA=0

# Passkeys (WebAuthn). RP ID is the bare domain; origin must match the URL in the browser exactly.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Dev only: shows a button that completes the World ID signup step with a random nullifier.
DEV_FAKE_WORLD_ID=0
